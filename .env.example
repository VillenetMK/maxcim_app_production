# Flask
SECRET_KEY=cambia-esta-clave-en-produccion
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=true
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_TOKEN_ENCRYPTION_KEY=

# MySQL 8
# También se puede usar una sola DATABASE_URL=mysql://usuario:clave@host:3306/base
DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=maxcim_app
MYSQL_PASSWORD=
MYSQL_DATABASE=maxcim_app

# API institucional CIMA (fuente de verdad)
INSTITUTIONAL_API_BASE_URL=
INSTITUTIONAL_API_LOGIN_PATH=/v1/auth/login
INSTITUTIONAL_API_GOOGLE_LOGIN_PATH=/v1/auth/google
INSTITUTIONAL_API_CLASSROOMS_PATH=/v1/teachers/{teacher_id}/classrooms
INSTITUTIONAL_API_STUDENT_PATH=/v1/students/{person_id}
INSTITUTIONAL_API_SERVICE_TOKEN=
INSTITUTIONAL_API_TIMEOUT_SECONDS=8
INSTITUTIONAL_API_VERIFY_TLS=true

# Google Workspace / OpenID Connect para docentes
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Uno o varios dominios separados por coma; no permite cuentas personales.
GOOGLE_OAUTH_ALLOWED_DOMAINS=
# En producción: https://tu-dominio/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_TIMEOUT_SECONDS=8

# Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Puck

# Integración MAXCIM / reconocimiento facial
FACE_MATCH_MIN_CONFIDENCE=0.85
MAXCIM_WEBHOOK_SECRET=cambia-este-secreto-compartido
